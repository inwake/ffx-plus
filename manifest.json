{
  "manifest_version": 3,
  "name": "FFxPlus",
  "version": "1.0",
  "description": "Firefox additions",
  "developer": {
    "name": "inwake"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ffx-plus@inwake",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "cookies",
    "scripting"
  ],
  "commands": {
    "open-selected": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "Open selected"
    }
  },
  "background": {
    "scripts": ["openSelected.js"]
  }
}
